<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <IsWindows>$([MSBuild]::IsOSPlatform('windows'))</IsWindows>
    <TargetFrameworks Condition="'$(IsWindows)' == 'true'">net8.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(IsWindows)' != 'true'">net8.0</TargetFrameworks>
    <RuntimeIdentifiers Condition="'$(IsWindows)' == 'true'">win-x64</RuntimeIdentifiers>
    <OutputType Condition="'$(IsWindows)' == 'true'">WinExe</OutputType>
    <OutputType Condition="'$(IsWindows)' != 'true'">Library</OutputType>
    <RootNamespace>ADSOLUSOL.Presentation.Desktop</RootNamespace>
    <!-- Indicar compilación desempaquetada nativa (Non-MSIX) -->
    <WindowsPackageType>None</WindowsPackageType>
    <AppxPackage Condition="'$(IsWindows)' == 'true'">false</AppxPackage>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <WindowsAppSDKSelfContained Condition="'$(WindowsPackageType)' == 'None'">false</WindowsAppSDKSelfContained>
    <UseMaui Condition="'$(IsWindows)' == 'true'">true</UseMaui>
    <SingleProject Condition="'$(IsWindows)' == 'true'">true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MauiVersion Condition="'$(MauiVersion)' == ''">8.0.3</MauiVersion>
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
    <IgnoreMissingWorkloads>true</IgnoreMissingWorkloads>
    <SkipCheckForMissingWorkloads>true</SkipCheckForMissingWorkloads>
    <SkipCheckForMissingWorkload>true</SkipCheckForMissingWorkload>
    <SkipWorkloadValidation>true</SkipWorkloadValidation>
    <SkipValidateMauiWorkloads>true</SkipValidateMauiWorkloads>

    <!-- Metadatos de Confianza e Identidad Corporativa -->
    <Company>KLIK Soft PRO / solusol.net</Company>
    <Product>AD SOLUSOL - Advertising &amp; Growth Engine</Product>
    <AssemblyTitle>ADSOLUSOL.Presentation.Desktop</AssemblyTitle>
    <Description>Motor de publicidad, monetización y analítica publicitaria del ecosistema solusol.net</Description>
    <Copyright>Copyright © 2026 solusol.net. Todos los derechos reservados.</Copyright>
    <Deterministic>true</Deterministic>
    <HighEntropyVA>true</HighEntropyVA>
    <NoWarn Condition="'$(IsWindows)' != 'true'">$(NoWarn);CS2008</NoWarn>

    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="'$(IsWindows)' == 'true' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="'$(IsWindows)' == 'true' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsWindows)' == 'true'">
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ADSOLUSOL.Application\ADSOLUSOL.Application.csproj" />
    <ProjectReference Include="..\ADSOLUSOL.Domain\ADSOLUSOL.Domain.csproj" />
    <ProjectReference Include="..\ADSOLUSOL.Infrastructure\ADSOLUSOL.Infrastructure.csproj" />
  </ItemGroup>

  <!-- En entornos CI sin Windows App SDK (Linux/macOS), excluimos los archivos de la app nativa WinUI -->
  <ItemGroup Condition="'$(IsWindows)' != 'true'">
    <Compile Remove="**\*.cs" />
  </ItemGroup>

  <!-- Neutraliza la exigencia de workloads móviles/Tizen (NETSDK1147) para la compilación de escritorio Windows -->
  <Target Name="_CheckForMissingWorkload" />
  <Target Name="_CheckForMissingWorkloads" />
  <Target Name="_CheckForMissingWorkloadDuringRestore" />

</Project>